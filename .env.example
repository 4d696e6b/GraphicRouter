# Optional for Builder B's Canva integration. Keep real values in ignored
# .env.local for development and Sites secret storage for production.
SITE_ORIGIN=http://localhost:5173
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:5173/api/canva/callback
# Base64 of 32 random bytes; store in Sites secrets. Keep stable to decrypt tokens.
CANVA_TOKEN_KEY=
# No OpenAI API key is required: ChatGPT provides the structured tool arguments.
